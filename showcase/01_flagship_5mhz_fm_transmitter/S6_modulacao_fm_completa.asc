TEXT 48 680 Left 2 !.model NPN NPN\n.model PNP PNP\n.lib C:\\Users\\caiom\\AppData\\Local\\LTspice\\lib\\cmp\\standard.bjt\n.include models/SMV1237.sub
TEXT 48 740 Left 2 !.tran 0 4m 0 2n startup\n.meas tran T100 TRIG V(B,BIAS) VAL=0 TD=2m RISE=1 TARG V(B,BIAS) VAL=0 TD=2m RISE=101\n.meas tran FOSC PARAM 100/T100\n.meas tran VOUT_PP PP V(OUT) FROM=2m TO=4m\n.meas tran VOUT_RMS RMS V(OUT) FROM=2m TO=4m\n.meas tran POUT PARAM (VOUT_RMS*VOUT_RMS)/50\n.meas tran IVOSC_AVG AVG -I(VOSC) FROM=2m TO=4m\n.meas tran PVCO PARAM 9*IVOSC_AVG\n.meas tran IVAUX_AVG AVG -I(VAUX) FROM=2m TO=4m\n.meas tran PAUX PARAM 9*IVAUX_AVG\n.meas tran PTOTAL PARAM PVCO+PAUX\n.meas tran EFF_TOTAL PARAM POUT/PTOTAL
